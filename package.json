{
  "name": "@local/dsh-bilibili",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "B站独立账号、消息、视频下载和主 Agent 阅读协作。",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "node": "./src/client.js",
      "default": "./client.js"
    },
    "./media": "./src/media.js",
    "./monitor": "./src/monitor.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "client.js",
    "plugin-settings.js",
    "settings-ui.js",
    "scripts/build-settings.mjs",
    "settings-account-ui.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:settings": "node scripts/build-settings.mjs",
    "build": "npm run build:settings"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.18.4 || 3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsakuraAOI/dsh-bilibili.git"
  },
  "homepage": "https://github.com/AsakuraAOI/dsh-bilibili#readme",
  "bugs": {
    "url": "https://github.com/AsakuraAOI/dsh-bilibili/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "pluginPage": {
    "name": "@local/dsh-bilibili",
    "title": "B站账号与视频阅读",
    "route": "/api/plugins/dsh-bilibili/settings",
    "titles": {
      "kasumi-retry": "Kasumi 重试与续写",
      "hiagent-global": "Kasumi 全局适配",
      "hiagent-global-compaction": "全局压缩",
      "hiagent-observability": "性能观测",
      "hiagent-recovery": "恢复保护",
      "hiagent-query-budget": "请求预算",
      "bilibili-account": "B站账号与视频阅读",
      "hiagent-web-search": "网页搜索与读取",
      "seeit-video": "Seeit 视频理解",
      "session-md-export": "导出选项",
      "kasumiflow": "学习事务与课程资料"
    },
    "account": true,
    "accountRoute": "/api/plugins/dsh-bilibili/account"
  }
}
